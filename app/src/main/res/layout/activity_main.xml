<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_screen">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/header_red"
            app:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/header_red"
                app:contentInsetStart="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="4dp">

                    <ImageView
                        android:id="@+id/ivMenu"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Mở menu"
                        android:focusable="true"
                        android:padding="12dp"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/on_brand" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:letterSpacing="0.08"
                        android:text="VLOTTERY"
                        android:textColor="@color/on_brand"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivAccount"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Hồ sơ cá nhân"
                        android:focusable="true"
                        android:padding="12dp"
                        android:src="@drawable/ic_account"
                        app:tint="@color/on_brand" />
                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Lời chào: nối liền thanh tiêu đề đỏ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_hero_bg"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="56dp">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xin chào 👋"
                        android:textColor="@color/on_brand"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.85"
                        android:textColor="@color/on_brand"
                        android:textSize="14sp"
                        tools:text="Thứ Năm, 20/11/2026" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-40dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <!-- Kết quả hôm nay của 3 miền (các dòng được thêm trong MainActivity) -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/HomeCard"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_icon_circle_red">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_star_filled"
                                        app:tint="@color/icon_red" />
                                </FrameLayout>

                                <TextView
                                    style="@style/HomeCardTitle"
                                    android:text="Kết quả hôm nay" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Giải Đặc Biệt"
                                    android:textColor="@color/text_tertiary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutToday"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Lối tắt: Dò vé + Trợ lý AI -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTicketCheck"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="Dò vé số"
                            android:textColor="@color/on_brand"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/header_red"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_ticket"
                            app:iconGravity="textStart"
                            app:iconTint="@color/on_brand" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAiAssistant"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Trợ lý AI"
                            android:textColor="@color/on_brand_container"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/brand_container"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_ai"
                            app:iconGravity="textStart"
                            app:iconTint="@color/on_brand_container" />
                    </LinearLayout>

                    <!-- Xổ Số Kiến Thiết -->
                    <com.google.android.material.card.MaterialCardView style="@style/HomeCard">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_icon_circle_blue">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_map_pin"
                                        app:tint="@color/icon_blue" />
                                </FrameLayout>

                                <TextView
                                    style="@style/HomeCardTitle"
                                    android:text="Xổ Số Kiến Thiết" />
                            </LinearLayout>

                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:columnCount="4">

                                <LinearLayout
                                    android:id="@+id/btnMienNam"
                                    style="@style/HomeTile">

                                    <FrameLayout
                                        style="@style/HomeTileIconBox"
                                        android:background="@drawable/bg_icon_circle_green">

                                        <ImageView
                                            style="@style/HomeTileIcon"
                                            android:src="@drawable/ic_map_pin"
                                            app:tint="@color/icon_green" />
                                    </FrameLayout>

                                    <TextView
                                        style="@style/HomeTileLabel"
                                        android:text="Miền Nam" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnMienTrung"
                                    style="@style/HomeTile">

                                    <FrameLayout
                                        style="@style/HomeTileIconBox"
                                        android:background="@drawable/bg_icon_circle_orange">

                                        <ImageView
                                            style="@style/HomeTileIcon"
                                            android:src="@drawable/ic_map_pin"
                                            app:tint="@color/icon_orange" />
                                    </FrameLayout>

                                    <TextView
                                        style="@style/HomeTileLabel"
                                        android:text="Miền Trung" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnMienBac"
                                    style="@style/HomeTile">

                                    <FrameLayout
                                        style="@style/HomeTileIconBox"
                                        android:background="@drawable/bg_icon_circle_red">

                                        <ImageView
                                            style="@style/HomeTileIcon"
                                            android:src="@drawable/ic_map_pin"
                                            app:tint="@color/icon_red" />
                                    </FrameLayout>

                                    <TextView
                                        style="@style/HomeTileLabel"
                                        android:text="Miền Bắc" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnThongKe"
                                    style="@style/HomeTile">

                                    <FrameLayout
                                        style="@style/HomeTileIconBox"
                                        android:background="@drawable/bg_icon_circle_purple">

                                        <ImageView
                                            style="@style/HomeTileIcon"
                                            android:src="@drawable/ic_bar_chart"
                                            app:tint="@color/icon_purple" />
                                    </FrameLayout>

                                    <TextView
                                        style="@style/HomeTileLabel"
                                        android:text="Thống kê" />
                                </LinearLayout>
                            </GridLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Vietlott & Điện toán -->
                    <com.google.android.material.card.MaterialCardView style="@style/HomeCard">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_icon_circle_orange">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_star_filled"
                                        app:tint="@color/icon_orange" />
                                </FrameLayout>

                                <TextView
                                    style="@style/HomeCardTitle"
                                    android:text="Vietlott &amp; Điện toán" />
                            </LinearLayout>

                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:columnCount="3">

                                <LinearLayout
                                    android:id="@+id/btnMega"
                                    style="@style/HomeTile">

                                    <FrameLayout
                                        style="@style/HomeTileIconBox"
                                        android:background="@drawable/bg_icon_circle_red">

                                        <ImageView
                                            style="@style/HomeTileIcon"
                                            android:src="@drawable/ic_star_filled"
                                            app:tint="@color/icon_red" />
                                    </FrameLayout>

                                    <TextView
                                        style="@style/HomeTileLabel"
                                        android:text="Mega 6/45" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnPower"
                                    style="@style/HomeTile">

                                    <FrameLayout
                                        style="@style/HomeTileIconBox"
                                        android:background="@drawable/bg_icon_circle_orange">

                                        <ImageView
                                            style="@style/HomeTileIcon"
                                            android:src="@drawable/ic_star_filled"
                                            app:tint="@color/icon_orange" />
                                    </FrameLayout>

                                    <TextView
                                        style="@style/HomeTileLabel"
                                        android:text="Power 6/55" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnKeno"
                                    style="@style/HomeTile">

                                    <FrameLayout
                                        style="@style/HomeTileIconBox"
                                        android:background="@drawable/bg_icon_circle_green">

                                        <ImageView
                                            style="@style/HomeTileIcon"
                                            android:src="@drawable/ic_ticket"
                                            app:tint="@color/icon_green" />
                                    </FrameLayout>

                                    <TextView
                                        style="@style/HomeTileLabel"
                                        android:text="Keno" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnMax3D"
                                    style="@style/HomeTile">

                                    <FrameLayout
                                        style="@style/HomeTileIconBox"
                                        android:background="@drawable/bg_icon_circle_blue">

                                        <ImageView
                                            style="@style/HomeTileIcon"
                                            android:src="@drawable/ic_dice"
                                            app:tint="@color/icon_blue" />
                                    </FrameLayout>

                                    <TextView
                                        style="@style/HomeTileLabel"
                                        android:text="Max 3D" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnMax3DPro"
                                    style="@style/HomeTile">

                                    <FrameLayout
                                        style="@style/HomeTileIconBox"
                                        android:background="@drawable/bg_icon_circle_purple">

                                        <ImageView
                                            style="@style/HomeTileIcon"
                                            android:src="@drawable/ic_dice"
                                            app:tint="@color/icon_purple" />
                                    </FrameLayout>

                                    <TextView
                                        style="@style/HomeTileLabel"
                                        android:text="Max 3D Pro" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnXsdt"
                                    style="@style/HomeTile">

                                    <FrameLayout
                                        style="@style/HomeTileIconBox"
                                        android:background="@drawable/bg_icon_circle_teal">

                                        <ImageView
                                            style="@style/HomeTileIcon"
                                            android:src="@drawable/ic_ticket"
                                            app:tint="@color/icon_teal" />
                                    </FrameLayout>

                                    <TextView
                                        style="@style/HomeTileLabel"
                                        android:text="Điện toán" />
                                </LinearLayout>
                            </GridLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Nhắc chơi có trách nhiệm -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:paddingHorizontal="16dp"
                        android:text="Xổ số là trò chơi ngẫu nhiên, không ai đoán trước được kết quả.\nHãy chơi có trách nhiệm và luôn đối chiếu vé tại đại lý chính thức."
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogout"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="Đăng xuất"
                        android:textColor="@color/icon_red"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/text_secondary"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
