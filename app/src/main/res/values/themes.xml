<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Theme dùng chung cho cả chế độ sáng và tối: chỉ tham chiếu tên màu,
        giá trị sáng/tối nằm ở values/colors.xml và values-night/colors.xml.
        (Không tạo values-night/themes.xml riêng, nếu không sẽ mất các màu dưới đây ở chế độ tối.)
    -->
    <style name="Base.Theme.LoterryApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/header_red</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/on_brand_container</item>

        <item name="android:colorBackground">@color/bg_screen</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorOutline">@color/card_stroke</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <!-- Material 3 mặc định phủ màu chủ đạo (đỏ) lên thẻ có bóng đổ làm thẻ bị ám hồng: tắt đi để thẻ đúng màu surface -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Thanh trạng thái cùng màu đỏ với thanh tiêu đề, chữ trắng -->
        <item name="android:statusBarColor">@color/header_red</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_screen</item>
    </style>

    <style name="Theme.LoterryApp" parent="Base.Theme.LoterryApp" />
</resources>
